<h1>予定一覧</h1>

<p>
  予定の合計数：<%= @posts_count %>件　
  本日の日付：<%= @today.strftime("%Y/%m/%d") %>
</p>

<%= link_to "新規追加", new_post_path %>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>タイトル</th>
      <th>開始日</th>
      <th>終了日</th>
      <th>終日</th>
      <th>更新日時</th>
      <th colspan="3">操作</th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= post.id %></td>
        <td><%= post.title %></td>
        <td><%= post.start_date.strftime("%Y/%m/%d") %></td>
        <td><%= post.end_date.strftime("%Y/%m/%d") %></td>
        <td><%= post.all_day? ? "○" : "" %></td>
        <td><%= post.updated_at.strftime("%Y/%m/%d %H:%M") %></td>
        <td><%= link_to "詳細", post_path(post) %></td>
        <td><%= link_to "編集", edit_post_path(post) %></td>
        <td>
          <%= link_to "削除", post_path(post),
                data: { turbo_method: :delete, turbo_confirm: "予定を削除しますか？" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
